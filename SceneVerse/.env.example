# Production Environment Variables Template for SceneVerse
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Database URL (Provided automatically by Render/Railway PostgreSQL or Neon)
# Example: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Email SMTP Credentials
EMAIL_HOST_USER=sceneverse10@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Optional: Cloudinary Storage for persistent uploads
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
